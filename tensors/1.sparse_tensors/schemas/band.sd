schema band {
    document band {
        field name type string {
            indexing: summary
        }

        field genres type tensor<float>(genres{}) {
            indexing: attribute | summary
        }
    }

    rank-profile genre_similarity {
        inputs {
            query(mytaste) tensor<float>(genres{})
        }

        function taste_score() {
            expression: sum(attribute(genres) * query(mytaste), genres)
        }

        first-phase {
            expression: taste_score
        }
    }
}
